/results/ground_*/
/results/payload_*/

# Synthetic pointing telemetry and comparison runs
/results/adcs_*/
/results/adcs_01_step_comparison.json

# Generated simulation results are not source code.
/results/

# Local backups created by the desktop input editor
/inputs/**/*.json.bak
/inputs/**/*.json.tmp
/inputs/**/.nirs_edited_*
